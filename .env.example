# Flask Secret Key
SECRET_KEY=change-this-to-a-random-secret-key

# Fernet Encryption Key (Generate using Fernet.generate_key().decode())
ENCRYPTION_KEY=

# Public App Base URL (Important on Render for password reset links)
# APP_URL=https://your-service-name.onrender.com

# Database (Render PostgreSQL internal/external URL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ----------------------------------------------------------------------------
# VOICE ASSISTANT
# ----------------------------------------------------------------------------
# The browser handles speech-to-text/text-to-speech. These controls apply to the
# server-side conversational layer, the command planner and pending actions.
# VOICE_RATE_LIMIT=20
# VOICE_RATE_WINDOW_SECONDS=60
# VOICE_PENDING_TTL_SECONDS=300
# VOICE_CONTEXT_TTL_SECONDS=1800
# VOICE_HISTORY_TURNS=6

# ----------------------------------------------------------------------------
# GOOGLE GEMINI (optional conversational AI)
# ----------------------------------------------------------------------------
# Without a key the assistant still works: it falls back to the deterministic
# planner and says plainly that it cannot answer general questions.
# Create a key at https://aistudio.google.com/apikey - never commit a real key.
# GEMINI_API_KEY=your_api_key
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT=10
# GEMINI_MAX_RETRIES=1
# GEMINI_ENABLED=true
# GEMINI_MAX_RETRIES=2
# What owner-scoped metadata may be included in a prompt:
#   names  = counts, folder names, recent file names, saved contact names (default)
#   counts = counts and folder names only
#   none   = nothing about the vault is sent
# VOICE_AI_METADATA=names

# ----------------------------------------------------------------------------
# EMAIL PROVIDER CONFIGURATION
# ----------------------------------------------------------------------------
# Option 1: HTTP API (RECOMMENDED for Render Free Tier - Port 443 is never blocked)
# Sign up free at https://resend.com (3,000 emails/month, 100/day, no credit card required)
# RESEND_API_KEY=re_your_api_key_here
# MAIL_DEFAULT_SENDER=Secure Vault <onboarding@resend.dev>

# Option 2: Gmail SMTP (For Local development or Render Paid Tier)
# NOTE: Render Free Tier BLOCKS outbound SMTP ports 25, 465, 587.
# NOTE: For Gmail, MAIL_PASSWORD must be a 16-character App Password (not your normal password):
#       https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
